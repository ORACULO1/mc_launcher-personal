{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chechenitza Studio",
  "version": "1.1.4",
  "identifier": "com.chechenitza.studio",
  "build": {
    "frontendDist": "../build/frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chechenitza Studio",
        "width": 1180,
        "height": 740,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "backgroundColor": "#12161d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/chechenitza-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFOTFBNzdFRDhCOTk1NEYKUldSUGxibllmcWVSUGt1ZGhidWI4UG9EWDh3NXFQRmFTQVZzSmo0V2VjOVpqS3oyK280MkVuN0UK",
      "endpoints": [
        "https://github.com/ORACULO1/mc_launcher-personal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
